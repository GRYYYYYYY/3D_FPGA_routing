@@ -0,0 +1,55 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include "vtr_log.h"
+
+/** @brief Opt-in non-overlapping planner phase times, split initial/refresh.
+ * These are instrumented development diagnostics, not formal speedup evidence.
+ */
+class H3dPlanProfile {
+  public:
+    enum class Phase { ELIGIBILITY, SOURCE, CANDIDATES, DISTANCE, SELECT, TABLE, SOLVE, PRIOR, OUTPUT, COUNT };
+    bool enabled = false; ///< Set before the first plan; disabled scopes read no clock.
+    /** @brief One plan's timing scope; early returns flush the active phase. */
+    class Scope {
+      public:
+        /** @brief Bind the scope to its initial or refresh aggregate. */
+        Scope(H3dPlanProfile& owner, bool refresh) : owner_(owner), group_(refresh ? 1 : 0) {
+            if (owner_.enabled) {++owner_.calls_[group_]; start_ = Clock::now();}
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+        /** @brief Flush the final phase, including on an early return. */
+        ~Scope() {enter(Phase::OUTPUT);}
+        /** @brief Attribute elapsed time to the previous phase and switch. */
+        void enter(Phase next) {
+            if (!owner_.enabled) return;
+            auto now = Clock::now();
+            owner_.seconds_[group_][size_t(phase_)] += std::chrono::duration<double>(now - start_).count();
+            start_ = now; phase_ = next;
+        }
+      private:
+        using Clock = std::chrono::steady_clock;
+        H3dPlanProfile& owner_; ///< Aggregate owner, alive longer than the scope.
+        size_t group_;         ///< Initial=0, refresh=1.
+        Phase phase_ = Phase::ELIGIBILITY; ///< Currently measured phase.
+        Clock::time_point start_;          ///< Beginning of current phase.
+    };
+    /** @brief Emit cumulative, disjoint phase totals for each planning mode. */
+    void log() const {
+        if (!enabled) return;
+        static constexpr std::array<const char*, size_t(Phase::COUNT)> names{
+            "eligibility", "source", "candidates", "distance", "select", "table", "solve", "prior", "output"};
+        for (size_t group = 0; group < 2; ++group) {
+            double total = 0.;
+            for (double value : seconds_[group]) total += value;
+            VTR_LOG("H3D_PLAN_PROFILE mode=%s calls=%zu total_seconds=%.9f", group ? "refresh" : "initial", calls_[group], total);
+            for (size_t phase = 0; phase < names.size(); ++phase)
+                VTR_LOG(" %s_seconds=%.9f", names[phase], seconds_[group][phase]);
+            VTR_LOG("\n");
+        }
+    }
+  private:
+    std::array<size_t, 2> calls_{}; ///< Number of entered scopes per mode.
+    std::array<std::array<double, size_t(Phase::COUNT)>, 2> seconds_{}; ///< Non-overlapping wall seconds.
+};
