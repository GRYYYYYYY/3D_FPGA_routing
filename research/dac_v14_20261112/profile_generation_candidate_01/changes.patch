+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <type_traits>
+#include <vector>
+#include "vtr_assert.h"
+
+/** @brief Reusable visit marks, cleared only on unsigned generation rollover.
+ * One instance is used sequentially, never by simultaneous graph queries.
+ */
+template<typename Stamp = uint32_t>
+class H3dVisitEpoch {
+  public:
+    static_assert(std::is_unsigned_v<Stamp>);
+    /** @brief Allocate one stamp per graph component. */
+    explicit H3dVisitEpoch(size_t count = 0) : marks_(count, 0) {}
+    /** @brief Start an empty logical visited set without resetting its storage. */
+    void begin() {
+        if (++epoch_ == 0) {std::fill(marks_.begin(), marks_.end(), 0); epoch_ = 1;}
+    }
+    /** @brief Return true exactly on this generation's first visit to node. */
+    bool insert(size_t node) {
+        VTR_ASSERT(epoch_ != 0 && node < marks_.size());
+        if (marks_[node] == epoch_) return false;
+        marks_[node] = epoch_;
+        return true;
+    }
+  private:
+    std::vector<Stamp> marks_; ///< Bounded storage proportional to component count.
+    Stamp epoch_ = 0;         ///< Zero is reserved for never-visited/reset entries.
+};
