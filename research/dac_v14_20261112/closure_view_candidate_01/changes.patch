+++ b/h3d_reachability_view.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "h3d_component_set.h"
+
+/** @brief Immutable union of endpoint-local components and shared hub closures.
+ *
+ * Owning const references keep a snapshot valid through index reconfiguration
+ * or destruction. Production configures once per graph and destroys endpoint
+ * caches with that graph. Intersection needs no expanded endpoint closure.
+ */
+class H3dReachabilityView {
+  public:
+    /** @brief Adopt sorted unique local components and immutable shared sets. */
+    H3dReachabilityView(std::vector<int> local,
+                        std::vector<std::shared_ptr<const H3dComponentSet>> shared)
+        : local_(std::move(local)), shared_(std::move(shared)) {
+        VTR_ASSERT_SAFE(std::is_sorted(local_.begin(), local_.end()));
+        VTR_ASSERT_SAFE(std::adjacent_find(local_.begin(), local_.end()) == local_.end());
+    }
+
+    /** @brief Exact intersection with component ids, without union expansion. */
+    bool intersects(const std::vector<int>& targets) const {
+        for (int value : targets) {
+            if (std::binary_search(local_.begin(), local_.end(), value)) return true;
+            for (const auto& suffix : shared_)
+                if (suffix->contains(value)) return true;
+        }
+        return false;
+    }
+
+    /** @brief Materialize the sorted unique union for legacy paths and tests. */
+    std::vector<int> materialize() const {
+        std::vector<int> result = local_;
+        for (const auto& suffix : shared_) result = suffix->merge(result);
+        return result;
+    }
+
+    /** @brief Actual local component count; shared sets are not counted again. */
+    size_t local_entries() const { return local_.size(); }
+    /** @brief Count of immutable shared-set references held by this endpoint. */
+    size_t shared_references() const { return shared_.size(); }
+
+  private:
+    std::vector<int> local_; ///< Sorted local traversal including encountered hub roots.
+    std::vector<std::shared_ptr<const H3dComponentSet>> shared_; ///< Shared immutable suffixes, possibly overlapping.
+};
