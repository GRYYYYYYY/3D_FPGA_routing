@@ -0,0 +1,16 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+/** @brief Admit an exactly measured alternative that is no slower within a small dead band and no pricier.
+ * Delay inputs use graph-delay units; negotiated opening charges use the same
+ * dimensionless planner scale. This local criterion is not a global QoR proof.
+ */
+inline bool h3d_equivalent_guide(double chosen_delay, double alternative_delay, double chosen_charge, double alternative_charge) {
+    if (!std::isfinite(chosen_delay) || !std::isfinite(alternative_delay)
+        || !std::isfinite(chosen_charge) || !std::isfinite(alternative_charge)
+        || chosen_delay < 0. || alternative_delay < 0. || chosen_charge < 0. || alternative_charge < 0.) return false;
+    return alternative_delay <= chosen_delay + .02
+           && alternative_charge <= chosen_charge + 1.e-10 * std::max(1., chosen_charge);
+}
