+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+/** @brief Deterministic refresh gate, called only after VPR chooses this net to reroute. */
+inline bool h3d_feedback_due(int iteration, int last_attempt, int cooldown,
+                             bool resource_overused, double criticality_drift, double crossing_change) {
+    return iteration - last_attempt >= cooldown
+           && (resource_overused || criticality_drift >= .15 || crossing_change >= .25);
+}
+
+/** @brief Refresh must improve the same current surrogate by a relative margin. */
+inline bool h3d_accept_refresh(double old_cost, double new_cost, double margin) {
+    return std::isfinite(new_cost)
+           && (!std::isfinite(old_cost) || new_cost < old_cost * (1. - margin));
+}
