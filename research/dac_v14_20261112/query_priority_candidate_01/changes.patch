+/** @brief Strict, default-off selection for congestion-triggered layer scope. */
+static bool h3d_layer_bb_feedback_enabled() {
+    static const bool enabled = [] {
+        const char* setting = std::getenv("VPR_H3D_LAYER_BB_FEEDBACK");
+        if (setting && std::strcmp(setting, "0") != 0 && std::strcmp(setting, "1") != 0)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_LAYER_BB_FEEDBACK must be 0 or 1");
+        return setting && std::strcmp(setting, "1") == 0;
+    }();
+    return enabled;
+}
+
+void h3d_expand_layer_bb_for_reroute(const Netlist<>& net_list,
+                                    ParentNetId net_id,
+                                    int iteration,
+                                    bool is_flat,
+                                    bool should_setup,
+                                    const t_bb& net_bb) {
+    if (!h3d_layer_bb_feedback_enabled()) return;
+#if defined(VPR_USE_TBB)
+    VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Layer BB feedback requires a serial VPR build");
+#endif
+    auto& routing = g_vpr_ctx.mutable_routing();
+    if (is_flat || &net_bb != &routing.route_bb[net_id])
+        VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Layer BB feedback supports serial clustered routing with the native net BB only");
+    if (iteration < 2 || !should_setup || net_list.net_is_global(net_id) || !routing.route_trees[net_id]) return;
+    const auto& device = g_vpr_ctx.device();
+    const int last_layer = device.grid.get_num_layers() - 1;
+    t_bb& bb = routing.route_bb[net_id];
+    if (bb.layer_min == 0 && bb.layer_max == last_layer) return;
+    // Called only after should_route_net accepts this net, before pruning.
+    // A larger search domain persists across route rollback, as with native
+    // full-device retry; no tree/occupancy/guide transaction is changed here.
+    for (const auto& node : routing.route_trees[net_id]->all_nodes()) {
+        const int occupancy = routing.rr_node_route_inf[node.inode].occ();
+        const int capacity = device.rr_graph.node_capacity(node.inode);
+        if (occupancy <= capacity) continue;
+        const int old_min = bb.layer_min;
+        const int old_max = bb.layer_max;
+        bb.layer_min = 0;
+        bb.layer_max = last_layer;
+        VTR_LOG("H3D_LAYER_BB_REFRESH iter=%d net=%zu witness_rr=%zu occ=%d cap=%d old_min=%d old_max=%d new_min=0 new_max=%d\n",
+                iteration, size_t(net_id), size_t(node.inode), occupancy, capacity, old_min, old_max, last_layer);
+        break;
+    }
+}
