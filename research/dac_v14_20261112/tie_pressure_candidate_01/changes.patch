+/** @brief Remove only a preference unsupported by a strict finite-objective gap.
+ * No epsilon or physical-delay interpretation: an unavailable or positive-gap
+ * alternative retains the original pressure. The native router remains free.
+ */
+inline float h3d_exact_tie_pressure(float original, double base, double excluded) {
+    return std::isfinite(base) && std::isfinite(excluded) && base == excluded ? 0.f : original;
