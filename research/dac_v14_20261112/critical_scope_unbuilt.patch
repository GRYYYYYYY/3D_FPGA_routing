+void h3d_expand_layer_bb_for_critical_targets(const Netlist<>& net_list,
+                                            ParentNetId net_id,
+                                            int iteration,
+                                            bool is_flat,
+                                            bool should_setup,
+                                            const t_bb& net_bb,
+                                            const std::vector<float>& criticality,
+                                            const std::vector<size_t>& remaining_targets) {
+    static const double threshold = [] {
+        const char* setting = std::getenv("VPR_H3D_LAYER_BB_CRITICALITY");
+        if (!setting) return -1.;
+        char* end = nullptr;
+        const double value = std::strtod(setting, &end);
+        if (end == setting || *end || !std::isfinite(value) || value < 0. || value > 1.)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_LAYER_BB_CRITICALITY must be in [0,1], or absent to disable");
+        const char* all = std::getenv("VPR_H3D_ALL_LAYER_BB");
+        if ((all && std::strcmp(all, "1") == 0) || h3d_layer_bb_delayed_enabled())
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Criticality layer BB is a separate alternative to initial-global or delayed-global expansion");
+        return value;
+    }();
+    if (threshold < 0. || !should_setup || net_list.net_is_global(net_id) || remaining_targets.empty()) return;
+#if defined(VPR_USE_TBB)
+    VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Criticality layer BB requires a serial VPR build");
+#endif
+    auto& routing = g_vpr_ctx.mutable_routing();
+    if (is_flat || &net_bb != &routing.route_bb[net_id])
+        VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Criticality layer BB requires clustered routing and the native net BB");
+    auto& bb = routing.route_bb[net_id];
+    const int last_layer = g_vpr_ctx.device().grid.get_num_layers() - 1;
+    if (bb.layer_min == 0 && bb.layer_max == last_layer) return;
+    size_t witness = 0;
+    float peak = -1.f;
+    for (size_t pin : remaining_targets) {
+        VTR_ASSERT(pin > 0 && size_t(pin) < criticality.size());
+        VTR_ASSERT(std::isfinite(criticality[pin]));
+        if (criticality[pin] > peak) { peak = criticality[pin]; witness = pin; }
+    }
+    const float cutoff = float(threshold);
+    if (peak < cutoff) return;
+    const int old_min = bb.layer_min, old_max = bb.layer_max;
+    bb.layer_min = 0;
+    bb.layer_max = last_layer;
+    VTR_LOG("H3D_LAYER_BB_CRITICAL iter=%d net=%zu remaining=%zu witness_pin=%zu criticality=%.17g threshold=%.17g old_min=%d old_max=%d new_min=0 new_max=%d\n",
+            iteration, size_t(net_id), remaining_targets.size(), witness, double(peak), double(cutoff), old_min, old_max, last_layer);
+}
