+
+/** @brief Isolate guide deactivation from candidate reassignment in development. */
+enum class e_h3d_feedback_action { ALL, CLEAR_ONLY, REASSIGN_ONLY };
+
+/** @brief Filter accepted proposals without changing their computation or cost. */
+inline bool h3d_allow_refresh_action(e_h3d_feedback_action action, bool clear) {
+    return action == e_h3d_feedback_action::ALL
+           || (clear ? action == e_h3d_feedback_action::CLEAR_ONLY
+                     : action == e_h3d_feedback_action::REASSIGN_ONLY);
+}
