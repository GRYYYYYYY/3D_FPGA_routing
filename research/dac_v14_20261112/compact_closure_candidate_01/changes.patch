--- a/h3d_component_set.h
+++ b/h3d_component_set.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+#include "vtr_assert.h"
+
+/** @brief Immutable sorted component set, optionally encoded as inclusive runs.
+ *
+ * Choose runs only when their two integer endpoints use fewer words than the
+ * plain set. Merge expands directly into the caller's result, so the cache
+ * does not retain a second uncompressed copy. Input sets are sorted and unique.
+ */
+class H3dComponentSet {
+  public:
+    H3dComponentSet(std::vector<int> values, bool compress)
+        : logical_size_(values.size()) {
+        VTR_ASSERT_SAFE(std::is_sorted(values.begin(), values.end()));
+        VTR_ASSERT_SAFE(std::adjacent_find(values.begin(), values.end()) == values.end());
+        if (!compress) { words_ = std::move(values); return; }
+        size_t runs = 0;
+        for (size_t i = 0; i < values.size(); ++i)
+            runs += i == 0 || static_cast<long long>(values[i]) != static_cast<long long>(values[i - 1]) + 1;
+        compressed_ = runs < values.size() - runs;
+        if (!compressed_) {
+            words_ = std::move(values);
+            return;
+        }
+        words_.reserve(2 * runs);
+        for (size_t i = 0; i < values.size(); ++i) {
+            if (i == 0 || static_cast<long long>(values[i]) != static_cast<long long>(values[i - 1]) + 1) {
+                words_.push_back(values[i]);
+                words_.push_back(values[i]);
+            } else {
+                words_.back() = values[i];
+            }
+        }
+    }
+
+    /** @brief Stored integer words charged against the cache limit. */
+    size_t stored_words() const { return words_.size(); }
+    /** @brief Number of represented components. */
+    size_t size() const { return logical_size_; }
+    /** @brief True if word pairs encode inclusive runs. */
+    bool compressed() const { return compressed_; }
+
+    /** @brief Return the exact sorted union with another sorted unique set. */
+    std::vector<int> merge(const std::vector<int>& local) const {
+        std::vector<int> result;
+        result.reserve(local.size() + logical_size_);
+        size_t cursor = 0;
+        auto emit = [&](int value) {
+            while (cursor < local.size() && local[cursor] < value) result.push_back(local[cursor++]);
+            if (cursor < local.size() && local[cursor] == value) ++cursor;
+            result.push_back(value);
+        };
+        if (compressed_) {
+            for (size_t run = 0; run < words_.size(); run += 2) {
+                int value = words_[run];
+                while (true) {
+                    emit(value);
+                    if (value == words_[run + 1]) break;
+                    ++value;
+                }
+            }
+        } else {
+            for (int value : words_) emit(value);
+        }
+        result.insert(result.end(), local.begin() + cursor, local.end());
+        return result;
+    }
+
+  private:
+    std::vector<int> words_; ///< Either plain ids or inclusive run endpoint pairs.
+    size_t logical_size_ = 0; ///< Exact uncompressed cardinality.
+    bool compressed_ = false; ///< Interpretation of words_.
+};
