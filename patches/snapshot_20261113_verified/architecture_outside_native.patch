diff --git a/vpr/src/route/h3d_bidirectional_delay.h b/vpr/src/route/h3d_bidirectional_delay.h
new file mode 100644
index 0000000..62d8fba
--- /dev/null
+++ b/vpr/src/route/h3d_bidirectional_delay.h
@@ -0,0 +1,111 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <limits>
+#include <optional>
+#include <queue>
+#include <stdexcept>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+/** @brief Candidate-specific directed shortest path with one shared work cap.
+ * Forward and reverse adapters must describe exactly the same immutable graph.
+ * Costs must be finite and nonnegative. A meeting path is only an upper bound;
+ * it becomes a measurement after the two frontier lower bounds prove optimality.
+ * This one-shot prototype deliberately exposes no partially completed state.
+ */
+class H3dBidirectionalDelay {
+  public:
+    enum class Stop { EXACT, UNREACHABLE, WORK_LIMIT, MEMORY_LIMIT };
+    struct Result {
+        Stop stop;
+        std::optional<double> exact;
+        size_t forward_settled, reverse_settled, peak_labels, peak_heap;
+        std::vector<std::pair<size_t, double>> forward_distances; ///< Optional settled endpoint-side labels, sorted by identity.
+        double forward_lower_bound = 0.; ///< Lower bound for unsettled endpoint-side nodes; valid only without memory stop.
+    };
+
+    /** @brief Prove one exact directed distance or return an explicit resource stop. */
+    template<typename Forward, typename Reverse>
+    static Result query(size_t source, size_t target, size_t budget,
+                        size_t label_limit, size_t heap_limit,
+                        Forward forward, Reverse reverse, bool capture_forward = false) {
+        if (label_limit < 2 || heap_limit < 2)
+            throw std::invalid_argument("bidirectional storage limits must admit two roots");
+        if (source == target) return {Stop::EXACT, 0., 0, 0, 0, 0, {}, 0.};
+        Side a(source), b(target);
+        double best = std::numeric_limits<double>::infinity();
+        size_t peak_labels = 2, peak_heap = 2;
+        bool memory_hit = false;
+        auto result = [&](Stop stop) {
+            Result answer{stop, stop == Stop::EXACT ? std::optional<double>(best) : std::nullopt,
+                          a.settled.size(), b.settled.size(), peak_labels, peak_heap, {}, 0.};
+            // Every settled label is exact independently of the meeting proof.
+            // A dropped relaxation on memory stop invalidates the remaining
+            // frontier bound, so expose no reusable certificate in that case.
+            if (capture_forward && stop != Stop::MEMORY_LIMIT) {
+                for (size_t node : a.settled) answer.forward_distances.emplace_back(node, a.distance.at(node));
+                std::sort(answer.forward_distances.begin(), answer.forward_distances.end());
+                answer.forward_lower_bound = a.heap.empty() ? std::numeric_limits<double>::infinity() : a.heap.top().first;
+            }
+            return answer;
+        };
+        auto meet = [&](size_t node, double value, const Side& other) {
+            auto opposite = other.distance.find(node);
+            if (opposite != other.distance.end()) best = std::min(best, value + opposite->second);
+        };
+        auto step = [&](Side& active, const Side& other, auto expand) {
+            auto [cost, node] = active.heap.top(); active.heap.pop();
+            active.settled.insert(node);
+            meet(node, cost, other);
+            expand(node, [&](size_t next, double delay) {
+                if (!std::isfinite(delay) || delay < 0.)
+                    throw std::invalid_argument("finite nonnegative delay required");
+                if (memory_hit || active.settled.contains(next)) return;
+                double value = cost + delay;
+                if (!std::isfinite(value)) throw std::overflow_error("delay sum overflow");
+                auto old = active.distance.find(next);
+                if (old != active.distance.end() && old->second <= value) return;
+                if ((old == active.distance.end() && a.distance.size() + b.distance.size() >= label_limit)
+                    || a.heap.size() + b.heap.size() >= heap_limit) {
+                    memory_hit = true; return;
+                }
+                active.distance[next] = value;
+                active.heap.emplace(value, next);
+                meet(next, value, other);
+                peak_labels = std::max(peak_labels, a.distance.size() + b.distance.size());
+                peak_heap = std::max(peak_heap, a.heap.size() + b.heap.size());
+            });
+        };
+        while (true) {
+            a.clean(); b.clean();
+            if (memory_hit) return result(Stop::MEMORY_LIMIT);
+            if (a.heap.empty() || b.heap.empty())
+                return result(std::isfinite(best) ? Stop::EXACT : Stop::UNREACHABLE);
+            double lo_a = a.heap.top().first, lo_b = b.heap.top().first;
+            if (std::isfinite(best) && lo_a + lo_b >= best) return result(Stop::EXACT);
+            if (a.settled.size() + b.settled.size() >= budget) return result(Stop::WORK_LIMIT);
+            if (lo_a < lo_b || (lo_a == lo_b && a.settled.size() <= b.settled.size()))
+                step(a, b, forward);
+            else step(b, a, reverse);
+        }
+    }
+
+  private:
+    struct Side {
+        using Item = std::pair<double,size_t>;
+        std::unordered_map<size_t,double> distance;
+        std::unordered_set<size_t> settled;
+        std::priority_queue<Item,std::vector<Item>,std::greater<Item>> heap;
+        explicit Side(size_t root) {distance[root] = 0.; heap.emplace(0., root);}
+        void clean() {
+            while (!heap.empty()) {
+                auto [cost,node] = heap.top();
+                if (!settled.contains(node) && cost == distance.at(node)) break;
+                heap.pop();
+            }
+        }
+    };
+};
diff --git a/vpr/src/route/h3d_bounded_critical_guide.h b/vpr/src/route/h3d_bounded_critical_guide.h
new file mode 100644
index 0000000..80233ff
--- /dev/null
+++ b/vpr/src/route/h3d_bounded_critical_guide.h
@@ -0,0 +1,21 @@
+#pragma once
+
+struct H3dBoundedCriticalCost {
+    bool applied;
+    float congestion, timing_seconds;
+};
+
+/** Replace only the method's extra critical crossing charge; the native
+ * congestion before that charge is retained exactly. Physical delay is not an
+ * input or output. RCV and every other edge retain their original policy. */
+inline H3dBoundedCriticalCost h3d_bounded_critical_cost(bool enabled,bool configurable,
+        bool crossing,bool preferred,bool rcv,float criticality,float native_congestion,
+        float old_congestion,float old_timing_seconds,float bounded_seconds,bool cap_only=false) {
+    if(enabled && configurable && crossing && !preferred && !rcv && criticality>=.9f) {
+        const double old_extra=(1.-double(criticality))*(double(old_congestion)-double(native_congestion));
+        const double bound=double(criticality*bounded_seconds);
+        if(cap_only && old_extra<=bound)return {false,old_congestion,old_timing_seconds};
+        return {true,native_congestion,bounded_seconds};
+    }
+    return {false,old_congestion,old_timing_seconds};
+}
diff --git a/vpr/src/route/h3d_calibrated_cost.h b/vpr/src/route/h3d_calibrated_cost.h
new file mode 100644
index 0000000..0792d3d
--- /dev/null
+++ b/vpr/src/route/h3d_calibrated_cost.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+/** @brief Fit an endpoint-local robust delay/proxy scale in normalized delay units.
+ * Eight prior observations at unit scale shrink small samples toward geometry.
+ * Measurements themselves are never shrunk; only missing distances use this fit.
+ * A zero measured distance is valid. Absent/nonfinite samples are not distances.
+ */
+inline double h3d_calibrated_scale(std::vector<double> ratios) {
+    ratios.erase(std::remove_if(ratios.begin(), ratios.end(), [](double x) {
+        return !std::isfinite(x) || x < 0.;
+    }), ratios.end());
+    if (ratios.empty()) return 1.;
+    std::sort(ratios.begin(), ratios.end());
+    size_t n = ratios.size();
+    double median = n % 2 ? ratios[n / 2] : .5 * (ratios[n / 2 - 1] + ratios[n / 2]);
+    return (n * median + 8.) / (n + 8.);
+}
diff --git a/vpr/src/route/h3d_candidate_path.h b/vpr/src/route/h3d_candidate_path.h
