+/** @brief Strict, default-off selection for congestion-triggered layer scope. */
+static bool h3d_layer_bb_feedback_enabled() {
+    static const bool enabled = [] {
+        const char* setting = std::getenv("VPR_H3D_LAYER_BB_FEEDBACK");
+        if (setting && std::strcmp(setting, "0") != 0 && std::strcmp(setting, "1") != 0)
