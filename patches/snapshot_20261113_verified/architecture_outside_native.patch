+++ b/vtr_flow/tasks/regression_tests/vtr_reg_strong/strong_h3d_crossing/run_regression.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Run the crossing adapter's standalone graph regressions.
+
+End-to-end foreign-RRG fixtures are generated by the research workspace's
+scripts/run_flatland_adapter_pilots_v2.py, followed by independent route audits.
+This driver checks the isolated closure/search algorithms without synthesis.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+import sys
+
+VTR = Path(__file__).resolve().parents[5]
+ROOT = VTR.parents[1]
+sys.path.insert(0, str(ROOT/'scripts'))
+from lazagna_common import sha256, utc, write_json
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', type=Path, default=ROOT/'results/architecture_flow_20261027/unit_regression')
+    out = parser.parse_args().output
+    out.mkdir(parents=True, exist_ok=False)
+    route = VTR/'vpr/src/route'
+    jobs = [('reachability', Path(__file__).with_name('test_reachability.cpp'),
+             [str(VTR/'libs/libvtrutil/src/vtr_assert.cpp')]),
+            ('delay_search', ROOT/'tests/test_delay_search.cpp', [])]
+    checks = []
+    for name, source, extra in jobs:
+        binary = out/name
+        command = ['g++','-std=c++20','-O2','-Wall','-Wextra','-DVTR_ASSERT_LEVEL=2',
+                   '-I',str(route),'-I',str(VTR/'libs/libvtrutil/src'),str(source),*extra,'-o',str(binary)]
+        with (out/(name+'.log')).open('w') as log:
+            subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,check=True)
+            subprocess.run([str(binary)],stdout=log,stderr=subprocess.STDOUT,timeout=30,check=True)
+        checks.append(dict(name=name,compile_command=command,source_sha256=sha256(source),
+            binary_sha256=sha256(binary),log_sha256=sha256(out/(name+'.log'))))
+    write_json(out/'manifest.json',dict(utc=utc(),passed=True,checks=checks,
+        headers={p.name:sha256(p) for p in [route/'h3d_reachability.h',route/'h3d_delay_search.h']}))
+    print('Crossing graph unit regressions passed')
+
+
+if __name__ == '__main__': main()
diff --git a/vtr_flow/tasks/regression_tests/vtr_reg_strong/strong_h3d_crossing/test_reachability.cpp b/vtr_flow/tasks/regression_tests/vtr_reg_strong/strong_h3d_crossing/test_reachability.cpp
