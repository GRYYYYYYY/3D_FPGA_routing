--- /dev/null
+++ b/vtr_flow/tasks/regression_tests/vtr_reg_strong/strong_h3d_crossing/test_reachability.cpp
@@ -0,0 +1,52 @@
+#include "h3d_reachability.h"
+
+#include <iostream>
+#include <random>
+
+/** @brief Compare both closure implementations with Floyd-Warshall and a large DAG. */
+int main() {
+    std::mt19937 random(20261027);
+    for (int trial = 0; trial < 300; ++trial) {
+        size_t n = 1 + random() % 12;
+        std::vector<std::pair<size_t, size_t>> edges;
+        std::vector<std::vector<bool>> closure(n, std::vector<bool>(n, false));
+        for (size_t a = 0; a < n; ++a) {
+            closure[a][a] = true;
+            for (size_t b = 0; b < n; ++b) {
+                if (random() % 5 == 0) {
+                    edges.emplace_back(a, b);
+                    closure[a][b] = true;
+                }
+            }
+        }
+        for (size_t k = 0; k < n; ++k)
+            for (size_t a = 0; a < n; ++a)
+                for (size_t b = 0; b < n; ++b)
+                    closure[a][b] = closure[a][b] || (closure[a][k] && closure[k][b]);
+        H3dReachabilityIndex index(n, edges);
+        for (size_t target = 0; target < n; ++target) {
+            auto forward_allowed = index.mark({index.component(target)}, true);
+            auto reverse_allowed = index.mark({index.component(target)}, false);
+            for (size_t source = 0; source < n; ++source) {
+                auto forward = index.relevant_components(source, false, forward_allowed, true);
+                auto reverse = index.relevant_components(source, true, reverse_allowed, true);
+                VTR_ASSERT(forward == index.relevant_components(source, false, forward_allowed));
+                VTR_ASSERT(reverse == index.relevant_components(source, true, reverse_allowed));
+                VTR_ASSERT(std::binary_search(forward.begin(), forward.end(), index.component(target)) == closure[source][target]);
+                VTR_ASSERT(std::binary_search(reverse.begin(), reverse.end(), index.component(target)) == closure[target][source]);
+            }
+        }
+    }
+    constexpr size_t n = 100001;
+    std::vector<std::pair<size_t, size_t>> edges;
+    for (size_t node = 1; node < n; ++node) edges.emplace_back(0, node);
+    H3dReachabilityIndex large(n, edges);
+    std::vector<bool> allowed(large.num_components(), true);
+    auto forward = large.relevant_components(0, false, allowed, true);
+    VTR_ASSERT(forward.size() == n);
+    for (size_t node = 0; node < n; ++node)
+        VTR_ASSERT(std::binary_search(forward.begin(), forward.end(), large.component(node)));
+    auto reverse = large.relevant_components(n-1, true, allowed, true);
+    VTR_ASSERT(reverse.size() == 2);
+    std::cout << "300 directed random graphs match Floyd-Warshall; old/new closures identical; 100001-node sparse DAG passes\n";
+}
