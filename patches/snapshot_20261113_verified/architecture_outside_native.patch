diff --git a/vpr/src/route/h3d_timing_regret.h b/vpr/src/route/h3d_timing_regret.h
new file mode 100644
index 0000000..aa91395
--- /dev/null
+++ b/vpr/src/route/h3d_timing_regret.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+/** @brief Bounded regret of an exactly measured alternative; not a physical delay correction.
+ * Both complete source-to-crossing and crossing-to-sink distances must be known
+ * before calling. A small dead band suppresses floating-point and near-tie noise.
+ */
+inline double h3d_timing_regret_seconds(double chosen, double alternative, double unit, double weight) {
+    if (!std::isfinite(chosen) || !std::isfinite(alternative) || !std::isfinite(unit)
+        || !std::isfinite(weight) || chosen < 0. || alternative < 0. || unit <= 0. || weight <= 0.) return 0.;
+    return std::min(weight, 1.) * std::min(unit, std::max(0., alternative - chosen - .02 * unit));
+}
diff --git a/vpr/src/route/h3d_visit_epoch.h b/vpr/src/route/h3d_visit_epoch.h
