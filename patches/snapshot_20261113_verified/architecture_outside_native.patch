+    size_t eligible_pins_ = 0, skipped_pins_ = 0, measured_pins_ = 0, unmeasured_pins_ = 0;
+};
diff --git a/vpr/src/route/h3d_feedback_policy.h b/vpr/src/route/h3d_feedback_policy.h
new file mode 100644
index 0000000..1f69ba8
--- /dev/null
+++ b/vpr/src/route/h3d_feedback_policy.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+/** @brief Deterministic refresh gate, called only after VPR chooses this net to reroute. */
+inline bool h3d_feedback_due(int iteration, int last_attempt, int cooldown,
+                             bool resource_overused, double criticality_drift, double crossing_change, bool newly_eligible_missing = false) {
+    return iteration - last_attempt >= cooldown
+           && (resource_overused || criticality_drift >= .15 || crossing_change >= .25 || newly_eligible_missing);
+}
+
+/** @brief Refresh must improve the same current surrogate by a relative margin. */
+inline bool h3d_accept_refresh(double old_cost, double new_cost, double margin) {
+    return std::isfinite(new_cost)
+           && (!std::isfinite(old_cost) || new_cost < old_cost * (1. - margin));
+}
+
+/** @brief Isolate guide deactivation from candidate reassignment in development. */
+enum class e_h3d_feedback_action { ALL, CLEAR_ONLY, REASSIGN_ONLY, FINITE_ONLY, INCOMPLETE_ONLY };
+
+/** @brief Filter accepted proposals without changing their computation or cost. */
+inline bool h3d_allow_refresh_action(e_h3d_feedback_action action, bool clear, bool prior_finite) {
+    if (action == e_h3d_feedback_action::ALL) return true;
+    if (clear) return action == e_h3d_feedback_action::CLEAR_ONLY;
+    return action == e_h3d_feedback_action::REASSIGN_ONLY
+           || (action == e_h3d_feedback_action::FINITE_ONLY && prior_finite)
+           || (action == e_h3d_feedback_action::INCOMPLETE_ONLY && !prior_finite);
+}
