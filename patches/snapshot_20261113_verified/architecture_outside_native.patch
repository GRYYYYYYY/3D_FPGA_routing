+#ifndef __FLUTE_H__
+#define __FLUTE_H__
+
+namespace Flute {
+
+/*****************************/
+/*  User-Defined Parameters  */
+/*****************************/
+#define FLUTE_ACCURACY 10             // Default accuracy
+#define FLUTE_ROUTING 1               // 1 to construct routing, 0 to estimate WL only
+#define FLUTE_LOCAL_REFINEMENT 1      // Suggestion: Set to 1 if ACCURACY >= 5
+#define FLUTE_REMOVE_DUPLICATE_PIN 0  // Remove dup. pin for flute_wl() & flute()
+
+#define FLUTE_POWVFILE "../../../POWV9.dat"  // LUT for POWV (Wirelength Vector)
+#define FLUTE_POSTFILE "../../../POST9.dat"  // LUT for POST (Steiner Tree)
+#define FLUTE_D 9                   // LUT is used for d <= FLUTE_D, FLUTE_D <= 9
+
+typedef int DTYPE;
+
+typedef struct {
+        DTYPE x, y;  // starting point of the branch
+        int n;       // index of neighbor
+} Branch;
+
+typedef struct {
+        int deg;         // degree
+        DTYPE length;    // total wirelength
+        Branch *branch;  // array of tree branches
+} Tree;
+
+// User-Callable Functions
+void readLUT(const char* directory);
+DTYPE flute_wl(int d, DTYPE x[], DTYPE y[], int acc);
+Tree flute(int d, DTYPE x[], DTYPE y[], int acc);
+DTYPE wirelength(Tree t);
+void printtree(Tree t);
+void plottree(Tree t);
+void free_tree(Tree t);
+
+// Other useful functions
+DTYPE flutes_wl_LD(int d, DTYPE xs[], DTYPE ys[], int s[]);
+DTYPE flutes_wl_MD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc);
+DTYPE flutes_wl_RDP(int d, DTYPE xs[], DTYPE ys[], int s[], int acc);
+Tree flutes_LD(int d, DTYPE xs[], DTYPE ys[], int s[]);
+Tree flutes_MD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc);
+Tree flutes_HD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc);
+Tree flutes_RDP(int d, DTYPE xs[], DTYPE ys[], int s[], int acc);
+
+inline DTYPE flutes_wl_LMD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        if (d <= FLUTE_D) {
+                return flutes_wl_LD(d, xs, ys, s);
+        } else {
+                return flutes_wl_MD(d, xs, ys, s, acc);
+        }
+}
+
+inline DTYPE flutes_wl_ALLD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        return flutes_wl_LMD(d, xs, ys, s, acc);
+}
+
+inline DTYPE flutes_wl(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        if (FLUTE_REMOVE_DUPLICATE_PIN == 1) {
+                return flutes_wl_RDP(d, xs, ys, s, acc);
+        } else {
+                return flutes_wl_ALLD(d, xs, ys, s, acc);
+        }
+}
+
+inline Tree flutes_ALLD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        if (d <= FLUTE_D) {
+                return flutes_LD(d, xs, ys, s);
+        } else {
+                return flutes_MD(d, xs, ys, s, acc);
+        }
+}
+
+inline Tree flutes(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        if (FLUTE_REMOVE_DUPLICATE_PIN == 1) {
+                return flutes_RDP(d, xs, ys, s, acc);
+        } else {
+                return flutes_ALLD(d, xs, ys, s, acc);
+        }
+}
+
+inline Tree flutes_LMD(int d, DTYPE xs[], DTYPE ys[], int s[], int acc) {
+        if (d <= FLUTE_D) {
+                return flutes_LD(d, xs, ys, s);
+        } else {
+                return flutes_MD(d, xs, ys, s, acc);
+        }
+}
+}  // namespace Flute
+#endif /* __FLUTE_H__ */
diff --git a/vpr/src/route/h3d_independent_plan.h b/vpr/src/route/h3d_independent_plan.h
new file mode 100644
index 0000000..3d90150
--- /dev/null
+++ b/vpr/src/route/h3d_independent_plan.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include "h3d_partition_dp.h"
+
+/** @brief Independent top-1 control over exactly the shared solver's finite table.
+ * Empty leaves return an unavailable plan, preserving the shared fallback.
+ * Candidate order is ascending; ties keep the smaller table index.
+ */
+inline t_h3d_partition_plan h3d_plan_independent(const std::vector<t_h3d_plan_leaf>& leaves,
+                                               const std::vector<double>& opening) {
+    t_h3d_partition_plan result{0., {}, 0};
+    for (const auto& leaf : leaves) {
+        double best = std::numeric_limits<double>::infinity();
+        size_t chosen = 0;
+        for (const auto& candidate : leaf.candidates) {
+            VTR_ASSERT(candidate.channel < opening.size());
+            double cost = opening[candidate.channel] + candidate.branch_cost;
+            if (cost < best) {
+                best = cost;
+                chosen = candidate.channel;
+            }
+        }
+        if(leaf.outside_cost<best) {best=leaf.outside_cost;chosen=opening.size();}
+        if (!std::isfinite(best)) return {};
+        result.cost += best;
+        result.assignment.emplace_back(leaf.pin, chosen);
+        if(chosen==opening.size())++result.outside_leaves;else ++result.groups;
+    }
+    std::sort(result.assignment.begin(), result.assignment.end());
+    return result;
+}
diff --git a/vpr/src/route/h3d_partition_dp.h b/vpr/src/route/h3d_partition_dp.h
new file mode 100644
index 0000000..98eaead
--- /dev/null
+++ b/vpr/src/route/h3d_partition_dp.h
@@ -0,0 +1,193 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <utility>
+#include <vector>
+
+#include "vtr_assert.h"
+
+/** @brief A verified candidate's sink-side cost in the planning surrogate. */
+struct t_h3d_candidate_cost {
+    size_t channel;     ///< Index in the planner's candidate table, not an RR node id.
+    double branch_cost; ///< Nonnegative sink-side surrogate cost; not final RC timing.
+};
+
+/** @brief One remote terminal and its individually reachable candidate channels. */
+struct t_h3d_plan_leaf {
+    int pin;                                      ///< Net pin index, unique among the leaves.
+    int x;                                        ///< Sink x coordinate for deterministic spatial hierarchy.
+    int y;                                        ///< Sink y coordinate for deterministic spatial hierarchy.
+    std::vector<t_h3d_candidate_cost> candidates; ///< Sorted by channel, with no duplicate channels.
+    double outside_cost=std::numeric_limits<double>::infinity(); ///< Optional existing-tree continuation; no crossing opened.
+};
+
+/** @brief Optimal plan within a fixed hierarchy and finite candidate sets. */
+struct t_h3d_partition_plan {
+    double cost = std::numeric_limits<double>::infinity(); ///< Surrogate objective, including each selected group opening.
+    std::vector<std::pair<int, size_t>> assignment;        ///< Net pin to preferred physical-channel table index.
+    size_t groups = 0;                                     ///< Number of physical crossing groups.
+    size_t outside_leaves = 0; ///< Outside assignments use channel==opening_cost.size(), not a real channel.
+};
+
+namespace h3d_detail {
+
+/** @brief A subtree optimum and costs if all of its leaves share each common candidate. */
+struct t_partial_plan {
+    t_h3d_partition_plan best;                      ///< Shared-versus-split optimum.
+    std::vector<t_h3d_candidate_cost> common_costs; ///< Sum of branch costs over all leaves for each common candidate.
+};
+
+/** @brief Recursively compare one shared crossing with the two child plans.
+ *
+ * Leaves are split by median along the wider coordinate range. The recurrence
+ * is exact only for this fixed hierarchy and the supplied additive surrogate:
+ * D(v) = min(min_c(open[c] + sum_{i in v} branch[i,c]), D(left)+D(right)).
+ * Each shared candidate must be present in every descendant leaf's feasible set.
+ * Neither arbitrary subset partitions nor joint detailed routing are optimized.
+ */
+inline t_partial_plan solve_partition(std::vector<t_h3d_plan_leaf> leaves,
+                                      const std::vector<double>& opening_cost) {
+    VTR_ASSERT(!leaves.empty());
+    t_partial_plan result;
+    if (leaves.size() == 1) {
+        result.common_costs = leaves.front().candidates;
+    } else {
+        int xmin = leaves.front().x;
+        int xmax = xmin;
+        int ymin = leaves.front().y;
+        int ymax = ymin;
+        for (const auto& leaf : leaves) {
+            xmin = std::min(xmin, leaf.x);
+            xmax = std::max(xmax, leaf.x);
+            ymin = std::min(ymin, leaf.y);
+            ymax = std::max(ymax, leaf.y);
+        }
+        bool split_x = xmax - xmin >= ymax - ymin;
+        std::stable_sort(leaves.begin(), leaves.end(), [split_x](const auto& lhs, const auto& rhs) {
+            if (split_x && lhs.x != rhs.x)
+                return lhs.x < rhs.x;
+            if (!split_x && lhs.y != rhs.y)
+                return lhs.y < rhs.y;
+            return lhs.pin < rhs.pin;
+        });
+        auto midpoint = leaves.begin() + leaves.size() / 2;
+        t_partial_plan left = solve_partition({leaves.begin(), midpoint}, opening_cost);
+        t_partial_plan right = solve_partition({midpoint, leaves.end()}, opening_cost);
+
+        result.best.cost = left.best.cost + right.best.cost;
+        if (std::isfinite(result.best.cost)) {
+            result.best.assignment = std::move(left.best.assignment);
+            result.best.assignment.insert(result.best.assignment.end(), right.best.assignment.begin(), right.best.assignment.end());
+            result.best.groups = left.best.groups + right.best.groups;
+            result.best.outside_leaves=left.best.outside_leaves+right.best.outside_leaves;
+        }
+
+        // Only intersect verified sets. A missing candidate is infeasible for
+        // this subtree; geometric proximity is never a connectivity proof.
+        size_t i = 0;
+        size_t j = 0;
+        while (i < left.common_costs.size() && j < right.common_costs.size()) {
+            const auto& a = left.common_costs[i];
+            const auto& b = right.common_costs[j];
+            if (a.channel < b.channel) {
+                ++i;
+            } else if (a.channel > b.channel) {
+                ++j;
+            } else {
+                result.common_costs.push_back({a.channel, a.branch_cost + b.branch_cost});
+                ++i;
+                ++j;
+            }
+        }
+    }
+
+    for (const auto& candidate : result.common_costs) {
+        VTR_ASSERT(candidate.channel < opening_cost.size());
+        double shared_cost = opening_cost[candidate.channel] + candidate.branch_cost;
+        // Prefer a shared group on a tie, then the lower candidate index.
+        if (shared_cost < result.best.cost || (shared_cost == result.best.cost && result.best.groups > 1)) {
+            result.best.cost = shared_cost;
+            result.best.groups = 1;
+            result.best.outside_leaves=0;
+            result.best.assignment.clear();
+            for (const auto& leaf : leaves)
+                result.best.assignment.emplace_back(leaf.pin, candidate.channel);
+        }
+    }
+    if(leaves.size()==1 && leaves.front().outside_cost<result.best.cost) {
+        result.best.cost=leaves.front().outside_cost;
+        result.best.assignment={{leaves.front().pin,opening_cost.size()}};
+        result.best.groups=0;result.best.outside_leaves=1;
+    }
+    return result;
+}
+
+} // namespace h3d_detail
+
+/** @brief Plan shared or split vertical channels using a finite hierarchical DP.
+ *
+ * Opening costs include the source-side access and one channel charge. Branch
+ * costs are counted for each terminal, so downstream shared wires/RC loads are
+ * not modeled exactly. A non-finite optimum means this restricted candidate
+ * problem has no plan; it is never proof that the RRG is unroutable.
+ */
+inline t_h3d_partition_plan h3d_plan_partition(const std::vector<t_h3d_plan_leaf>& leaves,
+                                               const std::vector<double>& opening_cost) {
+    if (leaves.empty())
+        return {0., {}, 0};
+    for (double cost : opening_cost)
+        VTR_ASSERT(std::isfinite(cost) && cost >= 0.);
+    for (const auto& leaf : leaves) {
+        VTR_ASSERT(!std::isnan(leaf.outside_cost) && leaf.outside_cost>=0.);
+        for (size_t i = 0; i < leaf.candidates.size(); ++i) {
+            const auto& candidate = leaf.candidates[i];
+            VTR_ASSERT(candidate.channel < opening_cost.size());
+            VTR_ASSERT(std::isfinite(candidate.branch_cost) && candidate.branch_cost >= 0.);
+            VTR_ASSERT(i == 0 || leaf.candidates[i - 1].channel < candidate.channel);
+        }
+    }
+    t_h3d_partition_plan result = h3d_detail::solve_partition(leaves, opening_cost).best;
+    std::sort(result.assignment.begin(), result.assignment.end());
+    return result;
+}
+
+/** @brief Evaluate a fixed pin assignment under the same deterministic hierarchy.
+ * A maximal subtree assigned one candidate pays its opening once; a split
+ * subtree pays each child. Missing/nonfinite assignments are unavailable.
+ */
+inline double h3d_assignment_cost(std::vector<t_h3d_plan_leaf> leaves,
+                                  const std::vector<double>& opening,
+                                  const std::vector<std::pair<int, size_t>>& assignment) {
+    if (leaves.empty()) return 0.;
+    size_t shared=opening.size();bool physical_seen=false,common=true;double branches=0.;
+    for(const auto& leaf:leaves) {
+        auto selected=std::find_if(assignment.begin(),assignment.end(),[&](const auto& a){return a.first==leaf.pin;});
+        if(selected==assignment.end())return std::numeric_limits<double>::infinity();
+        if(selected->second==opening.size()) {
+            if(!std::isfinite(leaf.outside_cost))return std::numeric_limits<double>::infinity();
+            if(leaves.size()==1)return leaf.outside_cost;
+            common=false;continue;
+        }
+        auto candidate=std::find_if(leaf.candidates.begin(),leaf.candidates.end(),[&](const auto& c){return c.channel==selected->second;});
+        if(candidate==leaf.candidates.end())return std::numeric_limits<double>::infinity();
+        if(!physical_seen){shared=selected->second;physical_seen=true;}
+        common=common && shared==selected->second;branches+=candidate->branch_cost;
+    }
+    if(common && physical_seen)return opening.at(shared)+branches;
+    int xmin = leaves.front().x, xmax = xmin, ymin = leaves.front().y, ymax = ymin;
+    for (const auto& leaf : leaves) {
+        xmin = std::min(xmin, leaf.x); xmax = std::max(xmax, leaf.x);
+        ymin = std::min(ymin, leaf.y); ymax = std::max(ymax, leaf.y);
+    }
+    bool split_x = xmax - xmin >= ymax - ymin;
+    std::stable_sort(leaves.begin(), leaves.end(), [split_x](const auto& a, const auto& b) {
+        if (split_x && a.x != b.x) return a.x < b.x;
+        if (!split_x && a.y != b.y) return a.y < b.y;
+        return a.pin < b.pin;
+    });
+    auto middle = leaves.begin() + leaves.size() / 2;
+    return h3d_assignment_cost({leaves.begin(), middle}, opening, assignment)
+           + h3d_assignment_cost({middle, leaves.end()}, opening, assignment);
+}
diff --git a/vpr/src/route/h3d_partition_sensitivity.h b/vpr/src/route/h3d_partition_sensitivity.h
new file mode 100644
index 0000000..b07c972
--- /dev/null
+++ b/vpr/src/route/h3d_partition_sensitivity.h
@@ -0,0 +1,143 @@
+#pragma once
+
+#include "h3d_partition_dp.h"
+#include <unordered_map>
+
+/** @brief Fixed-hierarchy optimal costs after forbidding one leaf/candidate pair.
+ * These are surrogate sensitivities, not physical timing guarantees. The current
+ * standalone diagnostic rebuilds the hierarchy from an existing finite table;
+ * it performs no graph query and does not change the production plan.
+ */
+struct t_h3d_partition_sensitivity {
+    double base_cost = 0.;
+    std::vector<double> exclusion_costs; ///< Same order as requested (pin, candidate) pairs.
+};
+
+/** @brief Remove only a preference unsupported by a strict finite-objective gap.
+ * No epsilon or physical-delay interpretation: an unavailable or positive-gap
+ * alternative retains the original pressure. The native router remains free.
+ */
+inline float h3d_exact_tie_pressure(float original, double base, double excluded) {
+    return std::isfinite(base) && std::isfinite(excluded) && base == excluded ? 0.f : original;
+}
+
+/** @brief Bounded relative surrogate sensitivity, not physical-delay confidence.
+ * Compare the net-level exclusion gap with this leaf's selected standalone
+ * opening-plus-branch cost, avoiding dilution by unrelated leaves' base cost.
+ * A finite-table unique choice preserves the original fallback pressure.
+ */
+inline float h3d_relative_margin_pressure(float original, double base, double excluded, double leaf_cost) {
+    VTR_ASSERT(std::isfinite(base) && base >= 0. && std::isfinite(leaf_cost) && leaf_cost >= 0.);
+    if (!std::isfinite(excluded)) return original;
+    double gap = excluded - base;
+    if (gap <= 0.) return 0.f;
+    double reliability_proxy = 1. / (1. + leaf_cost / gap);
+    return float(double(original) * reliability_proxy);
+}
+
+namespace h3d_sensitivity_detail {
+constexpr size_t none = std::numeric_limits<size_t>::max();
+constexpr double infinity = std::numeric_limits<double>::infinity();
+struct node {
+    size_t parent = none, left = none, right = none;
+    size_t shared_channel = none;
+    double shared_first = infinity, shared_second = infinity, best = infinity;
+    double excluding(size_t channel) const {
+        return channel == shared_channel ? shared_second : shared_first;
+    }
+};
+
+inline std::vector<t_h3d_candidate_cost> build(std::vector<t_h3d_plan_leaf> leaves,
+                                              const std::vector<double>& opening,
+                                              size_t id, std::vector<node>& nodes,
+                                              std::unordered_map<int, size_t>& pin_nodes) {
+    std::vector<t_h3d_candidate_cost> common;
+    if (leaves.size() == 1) {
+        bool inserted = pin_nodes.emplace(leaves.front().pin, id).second;
+        VTR_ASSERT(inserted);
+        (void)inserted;
+        common = leaves.front().candidates;
+    } else {
+        int xmin = leaves.front().x, xmax = xmin, ymin = leaves.front().y, ymax = ymin;
+        for (const auto& leaf : leaves) {
+            xmin = std::min(xmin, leaf.x); xmax = std::max(xmax, leaf.x);
+            ymin = std::min(ymin, leaf.y); ymax = std::max(ymax, leaf.y);
+        }
+        bool split_x = xmax - xmin >= ymax - ymin;
+        std::stable_sort(leaves.begin(), leaves.end(), [split_x](const auto& a, const auto& b) {
+            if (split_x && a.x != b.x) return a.x < b.x;
+            if (!split_x && a.y != b.y) return a.y < b.y;
+            return a.pin < b.pin;
+        });
+        size_t left = nodes.size(); nodes.emplace_back();
+        size_t right = nodes.size(); nodes.emplace_back();
+        nodes[id].left = left; nodes[id].right = right;
+        nodes[left].parent = nodes[right].parent = id;
+        auto middle = leaves.begin() + leaves.size() / 2;
+        auto a = build({leaves.begin(), middle}, opening, left, nodes, pin_nodes);
+        auto b = build({middle, leaves.end()}, opening, right, nodes, pin_nodes);
+        nodes[id].best = nodes[left].best + nodes[right].best;
+        size_t i = 0, j = 0;
+        while (i < a.size() && j < b.size()) {
+            if (a[i].channel < b[j].channel) ++i;
+            else if (a[i].channel > b[j].channel) ++j;
+            else {
+                common.push_back({a[i].channel, a[i].branch_cost + b[j].branch_cost});
+                ++i; ++j;
+            }
+        }
+    }
+    for (const auto& c : common) {
+        double cost = opening.at(c.channel) + c.branch_cost;
+        auto& n = nodes[id];
+        if (cost < n.shared_first) {
+            n.shared_second = n.shared_first;
+            n.shared_first = cost; n.shared_channel = c.channel;
+        } else if (cost < n.shared_second) n.shared_second = cost;
+        n.best = std::min(n.best, cost);
+    }
+    return common;
+}
+} // namespace h3d_sensitivity_detail
+
+/** @brief Compute each exclusion by walking only that leaf's ancestor chain.
+ * At an ancestor, sharing must avoid the excluded channel; splitting changes
+ * only the child containing the constrained leaf. The two cheapest common
+ * choices therefore suffice. This is exact for the same median hierarchy and
+ * additive finite objective as h3d_plan_partition, including tied alternatives.
+ * An infinite exclusion cost means no alternative in this finite model only.
+ */
+inline t_h3d_partition_sensitivity h3d_partition_exclusion_costs(
+    const std::vector<t_h3d_plan_leaf>& leaves,
+    const std::vector<double>& opening,
+    const std::vector<std::pair<int, size_t>>& requests) {
+    using namespace h3d_sensitivity_detail;
+    if (leaves.empty()) { VTR_ASSERT(requests.empty()); return {}; }
+    for (double cost : opening) VTR_ASSERT(std::isfinite(cost) && cost >= 0.);
+    for (const auto& leaf : leaves)
+        for (size_t i = 0; i < leaf.candidates.size(); ++i) {
+            const auto& c = leaf.candidates[i];
+            VTR_ASSERT(c.channel < opening.size() && std::isfinite(c.branch_cost) && c.branch_cost >= 0.);
+            VTR_ASSERT(i == 0 || leaf.candidates[i-1].channel < c.channel);
+        }
+    std::vector<node> nodes(1);
+    nodes.reserve(2 * leaves.size() - 1);
+    std::unordered_map<int, size_t> pin_nodes;
+    build(leaves, opening, 0, nodes, pin_nodes);
+    t_h3d_partition_sensitivity result;
+    result.base_cost = nodes.front().best;
+    for (const auto& [pin, channel] : requests) {
+        VTR_ASSERT(channel < opening.size() && pin_nodes.count(pin));
+        size_t id = pin_nodes.at(pin);
+        double cost = nodes[id].excluding(channel);
+        while (nodes[id].parent != none) {
+            size_t parent = nodes[id].parent;
+            const auto& p = nodes[parent];
+            double split = p.left == id ? cost + nodes[p.right].best : nodes[p.left].best + cost;
+            cost = std::min(p.excluding(channel), split);
+            id = parent;
+        }
+        result.exclusion_costs.push_back(cost);
+    }
+    return result;
+}
diff --git a/vpr/src/route/h3d_persistent_bidirectional.h b/vpr/src/route/h3d_persistent_bidirectional.h
new file mode 100644
index 0000000..a010c70
--- /dev/null
+++ b/vpr/src/route/h3d_persistent_bidirectional.h
@@ -0,0 +1,133 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <limits>
+#include <optional>
+#include <queue>
+#include <stdexcept>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+/** @brief Reuse one endpoint's Dijkstra frontier across directed terminal queries.
+ * Both graph adapters and the terminal predicate must describe one immutable
+ * graph. All terminals exist from the first query and have no outgoing edges.
+ * Each candidate gets a fresh reverse frontier. Work reports include both
+ * directions; callers preserve their lifetime budget even after state eviction.
+ */
+class H3dPersistentBidirectional {
+  public:
+    enum class Stop { EXACT, UNREACHABLE, WORK_LIMIT, MEMORY_LIMIT };
+    struct Result {
+        Stop stop;
+        std::optional<double> exact;
+        size_t forward_settled, reverse_settled, peak_labels, peak_heap;
+        std::vector<std::pair<size_t, double>> new_terminals;
+    };
+
+    explicit H3dPersistentBidirectional(size_t source) : endpoint_(source), forward_(source) {}
+
+    /** @brief Finite lower bound for every unsettled universal terminal.
+     * No certificate is exposed after a dropped endpoint relaxation. Empty
+     * frontier is deliberately not translated into a new infeasibility claim.
+     */
+    std::optional<double> unsettled_lower_bound() {
+        if (poisoned_) return std::nullopt;
+        forward_.clean();
+        if (forward_.heap.empty()) return std::nullopt;
+        return forward_.heap.top().first;
+    }
+
+    /** @brief Target and incidental terminal values are returned only if proved. */
+    template<typename Terminal, typename Forward, typename Reverse>
+    Result query(size_t target, size_t budget, size_t label_limit, size_t heap_limit,
+                 Terminal terminal, Forward outgoing, Reverse incoming) {
+        if (!terminal(target)) throw std::invalid_argument("persistent goal must be a terminal");
+        if (label_limit < 2 || heap_limit < 2) throw std::invalid_argument("limits must admit two roots");
+        if (forward_.settled.contains(target) || target == endpoint_)
+            return {Stop::EXACT, forward_.distance.at(target), 0, 0, forward_.distance.size(), forward_.heap.size(), {}};
+        if (poisoned_) return {Stop::MEMORY_LIMIT, std::nullopt, 0, 0, forward_.distance.size(), forward_.heap.size(), {}};
+        Side back(target);
+        size_t initial = forward_.settled.size();
+        size_t peak_labels = forward_.distance.size() + back.distance.size();
+        size_t peak_heap = forward_.heap.size() + back.heap.size();
+        double best = std::numeric_limits<double>::infinity();
+        bool memory_hit = peak_labels > label_limit || peak_heap > heap_limit;
+        std::vector<std::pair<size_t, double>> measured;
+        auto finish = [&](Stop stop) {
+            return Result{stop, stop == Stop::EXACT ? std::optional<double>(best) : std::nullopt,
+                          forward_.settled.size() - initial, back.settled.size(), peak_labels, peak_heap,
+                          std::move(measured)};
+        };
+        auto meet = [&](size_t node, double cost, const Side& other) {
+            auto found = other.distance.find(node);
+            if (found != other.distance.end()) best = std::min(best, cost + found->second);
+        };
+        // The old frontier may already label this new goal before this call.
+        meet(target, 0., forward_);
+        auto step = [&](Side& active, const Side& other, bool endpoint_side, auto expand) {
+            auto [cost, node] = active.heap.top(); active.heap.pop();
+            active.settled.insert(node);
+            meet(node, cost, other);
+            if (endpoint_side && terminal(node)) {
+                measured.emplace_back(node, cost);
+                return;
+            }
+            expand(node, [&](size_t next, double weight) {
+                if (!std::isfinite(weight) || weight < 0.) throw std::invalid_argument("finite nonnegative delay required");
+                if (memory_hit || active.settled.contains(next)) return;
+                double candidate = cost + weight;
+                if (!std::isfinite(candidate)) throw std::overflow_error("delay sum overflow");
+                auto found = active.distance.find(next);
+                if (found != active.distance.end() && found->second <= candidate) return;
+                if ((found == active.distance.end() && forward_.distance.size() + back.distance.size() >= label_limit)
+                    || forward_.heap.size() + back.heap.size() >= heap_limit) {
+                    memory_hit = true;
+                    // Dropping an endpoint-side relaxation corrupts that saved
+                    // frontier. A reverse-side stop does not corrupt its state.
+                    poisoned_ |= endpoint_side;
+                    return;
+                }
+                active.distance[next] = candidate;
+                active.heap.emplace(candidate, next);
+                meet(next, candidate, other);
+                peak_labels = std::max(peak_labels, forward_.distance.size() + back.distance.size());
+                peak_heap = std::max(peak_heap, forward_.heap.size() + back.heap.size());
+            });
+        };
+        while (true) {
+            forward_.clean(); back.clean();
+            if (memory_hit) return finish(Stop::MEMORY_LIMIT);
+            if (forward_.heap.empty() || back.heap.empty())
+                return finish(std::isfinite(best) ? Stop::EXACT : Stop::UNREACHABLE);
+            double a = forward_.heap.top().first, b = back.heap.top().first;
+            if (std::isfinite(best) && a + b >= best) return finish(Stop::EXACT);
+            size_t new_forward = forward_.settled.size() - initial;
+            if (new_forward + back.settled.size() >= budget) return finish(Stop::WORK_LIMIT);
+            if (a < b || (a == b && new_forward <= back.settled.size()))
+                step(forward_, back, true, outgoing);
+            else step(back, forward_, false, incoming);
+        }
+    }
+
+  private:
+    struct Side {
+        using Item = std::pair<double, size_t>;
+        std::unordered_map<size_t, double> distance;
+        std::unordered_set<size_t> settled;
+        std::priority_queue<Item, std::vector<Item>, std::greater<Item>> heap;
+        explicit Side(size_t root) { distance[root] = 0.; heap.emplace(0., root); }
+        void clean() {
+            while (!heap.empty()) {
+                auto [cost, node] = heap.top();
+                if (!settled.contains(node) && cost == distance.at(node)) break;
+                heap.pop();
+            }
+        }
+    };
+    size_t endpoint_;
+    Side forward_;
+    bool poisoned_ = false;
+};
diff --git a/vpr/src/route/h3d_plan_profile.h b/vpr/src/route/h3d_plan_profile.h
new file mode 100644
index 0000000..be40712
--- /dev/null
+++ b/vpr/src/route/h3d_plan_profile.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include "vtr_log.h"
+
+/** @brief Opt-in non-overlapping planner phase times, split initial/refresh.
+ * These are instrumented development diagnostics, not formal speedup evidence.
+ */
+class H3dPlanProfile {
+  public:
+    enum class Phase { ELIGIBILITY, SOURCE, CANDIDATES, DISTANCE, SELECT, TABLE, SOLVE, PRIOR, OUTPUT, COUNT };
+    bool enabled = false; ///< Set before the first plan; disabled scopes read no clock.
+    /** @brief One plan's timing scope; early returns flush the active phase. */
+    class Scope {
+      public:
+        /** @brief Bind the scope to its initial or refresh aggregate. */
+        Scope(H3dPlanProfile& owner, bool refresh) : owner_(owner), group_(refresh ? 1 : 0) {
+            if (owner_.enabled) {++owner_.calls_[group_]; start_ = Clock::now();}
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+        /** @brief Flush the final phase, including on an early return. */
+        ~Scope() {enter(Phase::OUTPUT);}
+        /** @brief Attribute elapsed time to the previous phase and switch. */
+        void enter(Phase next) {
+            if (!owner_.enabled) return;
+            auto now = Clock::now();
+            owner_.seconds_[group_][size_t(phase_)] += std::chrono::duration<double>(now - start_).count();
+            start_ = now; phase_ = next;
+        }
+      private:
+        using Clock = std::chrono::steady_clock;
+        H3dPlanProfile& owner_; ///< Aggregate owner, alive longer than the scope.
+        size_t group_;         ///< Initial=0, refresh=1.
+        Phase phase_ = Phase::ELIGIBILITY; ///< Currently measured phase.
+        Clock::time_point start_;          ///< Beginning of current phase.
+    };
+    /** @brief Emit cumulative, disjoint phase totals for each planning mode. */
+    void log() const {
+        if (!enabled) return;
+        static constexpr std::array<const char*, size_t(Phase::COUNT)> names{
+            "eligibility", "source", "candidates", "distance", "select", "table", "solve", "prior", "output"};
+        for (size_t group = 0; group < 2; ++group) {
+            double total = 0.;
+            for (double value : seconds_[group]) total += value;
+            VTR_LOG("H3D_PLAN_PROFILE mode=%s calls=%zu total_seconds=%.9f", group ? "refresh" : "initial", calls_[group], total);
+            for (size_t phase = 0; phase < names.size(); ++phase)
+                VTR_LOG(" %s_seconds=%.9f", names[phase], seconds_[group][phase]);
+            VTR_LOG("\n");
+        }
+    }
+  private:
+    std::array<size_t, 2> calls_{}; ///< Number of entered scopes per mode.
+    std::array<std::array<double, size_t(Phase::COUNT)>, 2> seconds_{}; ///< Non-overlapping wall seconds.
+};
diff --git a/vpr/src/route/h3d_reachability.h b/vpr/src/route/h3d_reachability.h
new file mode 100644
index 0000000..6be2967
--- /dev/null
+++ b/vpr/src/route/h3d_reachability.h
@@ -0,0 +1,267 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <iterator>
+#include <cstddef>
+#include <numeric>
+#include <utility>
+#include <unordered_set>
+#include <vector>
+
+#include "vtr_assert.h"
+#include "h3d_visit_epoch.h"
+#include "h3d_component_set.h"
+#include "h3d_reachability_view.h"
+
+/** @brief Exact directed reachability through a strongly connected component DAG.
+ *
+ * Vertex numbers here are generic graph indices. The VPR adapter supplies only
+ * same-layer non-CHANZ edges, so SCC membership certifies a same-die walk without
+ * inventing a reverse routing transition. No shortest-distance claim is made.
+ */
+class H3dReachabilityIndex {
+  public:
+    /** @brief Build SCCs iteratively (no deep recursion) and deduplicated DAGs. */
+    H3dReachabilityIndex(size_t vertices, const std::vector<std::pair<size_t, size_t>>& edges, bool generation_closure = false)
+        : generation_closure_(generation_closure) {
+        std::vector<size_t> out_begin(vertices + 1, 0), in_begin(vertices + 1, 0);
+        for (const auto& [source, sink] : edges) {
+            VTR_ASSERT(source < vertices && sink < vertices);
+            ++out_begin[source + 1];
+            ++in_begin[sink + 1];
+        }
+        std::partial_sum(out_begin.begin(), out_begin.end(), out_begin.begin());
+        std::partial_sum(in_begin.begin(), in_begin.end(), in_begin.begin());
+        std::vector<size_t> successors(edges.size()), predecessors(edges.size());
+        auto out_cursor = out_begin;
+        auto in_cursor = in_begin;
+        for (const auto& [source, sink] : edges) {
+            successors[out_cursor[source]++] = sink;
+            predecessors[in_cursor[sink]++] = source;
+        }
+        std::vector<bool> seen(vertices, false);
+        std::vector<size_t> order;
+        order.reserve(vertices);
+        for (size_t root = 0; root < vertices; ++root) {
+            if (seen[root]) continue;
+            std::vector<std::pair<size_t, size_t>> stack{{root, out_begin[root]}};
+            seen[root] = true;
+            while (!stack.empty()) {
+                auto& [node, cursor] = stack.back();
+                if (cursor == out_begin[node + 1]) {
+                    order.push_back(node);
+                    stack.pop_back();
+                } else {
+                    size_t next = successors[cursor++];
+                    if (!seen[next]) {
+                        seen[next] = true;
+                        stack.emplace_back(next, out_begin[next]);
+                    }
+                }
+            }
+        }
+        components_.assign(vertices, -1);
+        int component_count = 0;
+        for (auto root = order.rbegin(); root != order.rend(); ++root) {
+            if (components_[*root] >= 0) continue;
+            std::vector<size_t> stack{*root};
+            components_[*root] = component_count;
+            while (!stack.empty()) {
+                size_t node = stack.back();
+                stack.pop_back();
+                for (size_t edge = in_begin[node]; edge < in_begin[node + 1]; ++edge) {
+                    size_t next = predecessors[edge];
+                    if (components_[next] < 0) {
+                        components_[next] = component_count;
+                        stack.push_back(next);
+                    }
+                }
+            }
+            ++component_count;
+        }
+        forward_.resize(component_count);
+        reverse_.resize(component_count);
+        for (const auto& [source, sink] : edges) {
+            int a = components_[source];
+            int b = components_[sink];
+            if (a != b) forward_[a].push_back(b);
+        }
+        for (int a = 0; a < component_count; ++a) {
+            auto& outgoing = forward_[a];
+            std::sort(outgoing.begin(), outgoing.end());
+            outgoing.erase(std::unique(outgoing.begin(), outgoing.end()), outgoing.end());
+            for (int b : outgoing)
+                reverse_[b].push_back(a);
+        }
+        if (generation_closure_) visits_ = H3dVisitEpoch<>(component_count);
+    }
+
+    /** @brief Map a graph vertex to its strongly connected component. */
+    int component(size_t vertex) const { return components_.at(vertex); }
+
+    /** @brief Number of components in the condensation graph. */
+    size_t num_components() const { return forward_.size(); }
+
+    /** @brief Mark components reachable from several seeds in a chosen direction. */
+    std::vector<bool> mark(const std::vector<int>& seeds, bool backwards) const {
+        const auto& adjacency = backwards ? reverse_ : forward_;
+        std::vector<bool> result(adjacency.size(), false);
+        std::vector<int> queue;
+        for (int seed : seeds) {
+            if (!result[seed]) {
+                result[seed] = true;
+                queue.push_back(seed);
+            }
+        }
+        for (size_t i = 0; i < queue.size(); ++i)
+            for (int next : adjacency[queue[i]])
+                if (!result[next]) {
+                    result[next] = true;
+                    queue.push_back(next);
+                }
+        return result;
+    }
+
+    /** @brief Reach only relevant components; allowed must be closed toward the target seeds.
+     *
+     * For source-to-Z queries, allowed is the reverse reachability closure of
+     * all Z-entry components; for Z-to-sink queries it is the forward closure
+     * of all Z-exit components. This skips terminal dead ends without dropping
+     * a valid route to/from a channel. Result is sorted for exact intersection.
+     */
+    std::vector<int> relevant_components(size_t vertex, bool backwards, const std::vector<bool>& allowed, bool large_closure = false) const {
+        const auto& adjacency = backwards ? reverse_ : forward_;
+        int root = component(vertex);
+        if (!allowed[root]) return {};
+        std::vector<int> visited{root};
+        std::unordered_set<int> seen;
+        if (large_closure) {
+            if (generation_closure_) {visits_.begin(); visits_.insert(root);}
+            else seen.insert(root);
+        }
+        // Relevant pin-to-wire DAGs are small. Keeping the work set sparse
+        // avoids clearing a device-sized bitmap for every endpoint query.
+        for (size_t i = 0; i < visited.size(); ++i)
+            for (int next : adjacency[visited[i]])
+                if (allowed[next] && (large_closure ? (generation_closure_ ? visits_.insert(next) : seen.insert(next).second)
+                                                  : std::find(visited.begin(), visited.end(), next) == visited.end()))
+                    visited.push_back(next);
+        std::sort(visited.begin(), visited.end());
+        return visited;
+    }
+
+    /** @brief Cache bounded closures of large SCCs for two immutable allowed masks.
+     *
+     * The entry cap is shared across both directions. Reconfiguration discards
+     * all prior masks and closures. Refused caches retain the exact BFS fallback.
+     * Graph size and SCC membership choose hubs; no route outcomes are inputs.
+     */
+    void configure_shared_closures(const std::vector<bool>& forward_allowed,
+                                   const std::vector<bool>& reverse_allowed,
+                                   size_t entry_cap = 4 * 1024 * 1024,
+                                   size_t hub_cap = 8, size_t min_members = 64, bool compact = false) {
+        VTR_ASSERT(forward_allowed.size() == num_components());
+        VTR_ASSERT(reverse_allowed.size() == num_components());
+        shared_allowed_ = {forward_allowed, reverse_allowed};
+        shared_hubs_ = {};
+        shared_entries_ = 0;
+        shared_logical_entries_ = 0;
+        shared_admitted_ = 0;
+        shared_refused_ = 0;
+        // Shared queries use stamps even when the legacy query mode is off.
+        visits_ = H3dVisitEpoch<>(num_components());
+        std::vector<size_t> counts(num_components(), 0), representative(num_components(), 0);
+        for (size_t vertex = 0; vertex < components_.size(); ++vertex) {
+            ++counts[components_[vertex]];
+            representative[components_[vertex]] = vertex;
+        }
+        std::vector<std::pair<size_t, int>> ranked;
+        for (size_t c = 0; c < counts.size(); ++c)
+            if (counts[c] >= min_members) ranked.emplace_back(counts[c], int(c));
+        std::sort(ranked.rbegin(), ranked.rend());
+        if (ranked.size() > hub_cap) ranked.resize(hub_cap);
+        for (int direction = 0; direction < 2; ++direction) {
+            for (const auto& [members, component_id] : ranked) {
+                (void)members;
+                if (!shared_allowed_[direction][component_id]) continue;
+                auto closure = relevant_components(representative[component_id], direction != 0,
+                                                   shared_allowed_[direction], true);
+                H3dComponentSet stored(std::move(closure), compact);
+                if (stored.stored_words() <= entry_cap - shared_entries_) {
+                    shared_entries_ += stored.stored_words();
+                    shared_logical_entries_ += stored.size();
+                    ++shared_admitted_;
+                    shared_hubs_[direction].push_back({component_id, std::make_shared<const H3dComponentSet>(std::move(stored))});
+                } else ++shared_refused_;
+            }
+        }
+    }
+
+    /** @brief Exact closure with shared hub suffixes and local traversal.
+     *
+     * Encountering a cached hub replaces expansion by its full sorted closure.
+     * Local traversal and set union preserve all components including endpoints;
+     * overlapping hubs and alternate paths are deduplicated. Scratch is serial.
+     */
+    H3dReachabilityView shared_relevant_view(size_t vertex, bool backwards) const {
+        const size_t direction = backwards ? 1 : 0;
+        const auto& allowed = shared_allowed_[direction];
+        VTR_ASSERT(allowed.size() == num_components());
+        const int root = component(vertex);
+        if (!allowed[root]) return H3dReachabilityView({}, {});
+        const auto& adjacency = backwards ? reverse_ : forward_;
+        const auto& hubs = shared_hubs_[direction];
+        visits_.begin();
+        visits_.insert(root);
+        std::vector<int> local{root};
+        std::vector<size_t> used;
+        for (size_t i = 0; i < local.size(); ++i) {
+            size_t hub = 0;
+            for (; hub < hubs.size(); ++hub)
+                if (hubs[hub].root == local[i]) break;
+            if (hub < hubs.size()) {
+                used.push_back(hub);
+                continue;
+            }
+            for (int next : adjacency[local[i]])
+                if (allowed[next] && visits_.insert(next)) local.push_back(next);
+        }
+        std::sort(local.begin(), local.end());
+        std::vector<std::shared_ptr<const H3dComponentSet>> suffixes;
+        suffixes.reserve(used.size());
+        for (size_t hub : used) suffixes.push_back(hubs[hub].closure);
+        return H3dReachabilityView(std::move(local), std::move(suffixes));
+    }
+
+    /** @brief Materialize the exact shared closure for legacy callers. */
+    std::vector<int> shared_relevant_components(size_t vertex, bool backwards) const {
+        return shared_relevant_view(vertex, backwards).materialize();
+    }
+
+    /** @brief Number of component entries retained in shared closures. */
+    size_t shared_entries() const { return shared_entries_; }
+    /** @brief Uncompressed cardinality of admitted cached closures. */
+    size_t shared_logical_entries() const { return shared_logical_entries_; }
+    /** @brief Count of admitted hub/direction pairs. */
+    size_t shared_admitted() const { return shared_admitted_; }
+    /** @brief Count of hub/direction pairs declined by storage limit. */
+    size_t shared_refused() const { return shared_refused_; }
+
+  private:
+    struct t_shared_hub {
+        int root;                  ///< Cached component id.
+        std::shared_ptr<const H3dComponentSet> closure; ///< Immutable complete closure shared with endpoint snapshots.
+    };
+    std::array<std::vector<bool>, 2> shared_allowed_; ///< Owned static masks, isolated from caller mutation.
+    std::array<std::vector<t_shared_hub>, 2> shared_hubs_; ///< Bounded forward/reverse hub closures.
+    size_t shared_entries_ = 0; ///< Stored integer words across both directions, charged to the cap.
+    size_t shared_logical_entries_ = 0; ///< Total represented components.
+    size_t shared_admitted_ = 0; ///< Cached hub/direction pairs.
+    size_t shared_refused_ = 0; ///< Hub/direction pairs declined by storage cap.
+    bool generation_closure_ = false;       ///< Reuse visit stamps for sequential large-closure queries.
+    mutable H3dVisitEpoch<> visits_;        ///< Scratch marks; graph and returned closures remain immutable.
+    std::vector<int> components_;           ///< Component id for every generic input vertex.
+    std::vector<std::vector<int>> forward_; ///< Deduplicated DAG successors.
+    std::vector<std::vector<int>> reverse_; ///< DAG predecessors, used only for analysis.
+};
diff --git a/vpr/src/route/h3d_reachability_view.h b/vpr/src/route/h3d_reachability_view.h
new file mode 100644
index 0000000..954a557
--- /dev/null
+++ b/vpr/src/route/h3d_reachability_view.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "h3d_component_set.h"
+
+/** @brief Immutable union of endpoint-local components and shared hub closures.
+ *
+ * Owning const references keep a snapshot valid through index reconfiguration
+ * or destruction. Production configures once per graph and destroys endpoint
+ * caches with that graph. Intersection needs no expanded endpoint closure.
+ */
+class H3dReachabilityView {
+  public:
+    /** @brief Adopt sorted unique local components and immutable shared sets. */
+    H3dReachabilityView(std::vector<int> local,
+                        std::vector<std::shared_ptr<const H3dComponentSet>> shared)
+        : local_(std::move(local)), shared_(std::move(shared)) {
+        VTR_ASSERT_SAFE(std::is_sorted(local_.begin(), local_.end()));
+        VTR_ASSERT_SAFE(std::adjacent_find(local_.begin(), local_.end()) == local_.end());
+    }
+
+    /** @brief Exact intersection with component ids, without union expansion. */
+    bool intersects(const std::vector<int>& targets) const {
+        for (int value : targets) {
+            if (std::binary_search(local_.begin(), local_.end(), value)) return true;
+            for (const auto& suffix : shared_)
+                if (suffix->contains(value)) return true;
+        }
+        return false;
+    }
+
+    /** @brief Materialize the sorted unique union for legacy paths and tests. */
+    std::vector<int> materialize() const {
+        std::vector<int> result = local_;
+        for (const auto& suffix : shared_) result = suffix->merge(result);
+        return result;
+    }
+
+    /** @brief Actual local component count; shared sets are not counted again. */
+    size_t local_entries() const { return local_.size(); }
+    /** @brief Count of immutable shared-set references held by this endpoint. */
+    size_t shared_references() const { return shared_.size(); }
+
+  private:
+    std::vector<int> local_; ///< Sorted local traversal including encountered hub roots.
+    std::vector<std::shared_ptr<const H3dComponentSet>> shared_; ///< Shared immutable suffixes, possibly overlapping.
+};
diff --git a/vpr/src/route/h3d_routing.cpp b/vpr/src/route/h3d_routing.cpp
new file mode 100644
index 0000000..053568d
--- /dev/null
+++ b/vpr/src/route/h3d_routing.cpp
@@ -0,0 +1,1392 @@
+#include "h3d_routing.h"
+
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+#include <chrono>
+#include <memory>
+#include <numeric>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <fstream>
+#include <array>
+#include <sstream>
+#include <iomanip>
+
+#include "globals.h"
+#include "h3d_partition_dp.h"
+#include "h3d_fast_plan.h"
+#include "h3d_feedback_policy.h"
+#include "h3d_crossing.h"
+#include "route_common.h"
+#include "route_tree.h"
+#include "vpr_error.h"
+#include "vtr_log.h"
+
+namespace {
+
+bool bounded_legal_phase=false; ///< Native legal milestone, reset on each width trial.
+
+/** @brief Strictly parse a finite nonnegative experiment setting. */
+float read_number(const char* name, float default_value) {
+    const char* text = std::getenv(name);
+    if (!text)
+        return default_value;
+    errno = 0;
+    char* end = nullptr;
+    float parsed = std::strtof(text, &end);
+    if (errno || end == text || *end || !std::isfinite(parsed) || parsed < 0.f)
+        VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "%s must be finite and nonnegative, got '%s'", name, text);
+    return parsed;
+}
+
+/** @brief Explicit experimental modes; the detailed connection search is always VPR's. */
+enum class e_h3d_mode { OFF,
+                        CANDIDATES,
+                        STATIC,
+                        DYNAMIC,
+                        DYNAMIC_WHOLE,
+                        DYNAMIC_SUBTREE };
+
+/** @brief Immutable per-process settings, recorded at the first routing iteration. */
+struct t_settings {
+    double outside_eta=-1.;
+    int residual_query_mode=-1;
+    bool box_guide_admission = false;
+    bool trace_search_domain = false;
+    bool trace_guide_influence = false; ///< Read-only actual crossing-cost trace.
+    bool bounded_after_legal = false;
+    bool use_scc = false;              ///< Exact SCC reachability with geometric costs instead of full BFS distances.
+    e_h3d_mode mode = e_h3d_mode::OFF; ///< Candidate-planning ablation.
+    size_t candidates = 8;             ///< Diverse preferred candidates per remote terminal.
+    float miss_weight = 2.f;           ///< Additional relative CHANZ cost outside the preference set.
+    bool dp_tie_pressure = false; ///< Enable final-pressure records for the shared-DP tie ablation.
+    bool dp_margin_pressure = false; ///< Enable final-pressure records for the relative-margin ablation.
+    float opening_weight = 8.f;        ///< Channel-opening weight in hop-cost planning units.
+    bool delay_cost = false;
+    size_t delay_budget = 4096;
+    float min_criticality = 0.f;
+    std::string feedback_action_name = "all"; ///< Exact label for action-ablation provenance.
+    e_h3d_feedback_action feedback_action = e_h3d_feedback_action::ALL; ///< Development action ablation; full selective policy remains default.
+    bool eligibility_trigger = false; ///< Refresh missing guides when a remote pin newly crosses the selection threshold.
+    bool trace_prior = false; ///< Diagnose old-assignment coverage without changing refresh decisions.
+    bool trace_planar = false; ///< Decision-neutral pre-prune planar overuse diagnostics on native-selected reroutes.
+    bool trace_target_gate = false; ///< Compare whole-net and actual-target timing drift without changing refresh decisions.
+    bool target_drift = false; ///< Only native remaining targets contribute timing drift to target-restricted refresh.
+    bool target_feedback = false; ///< Limit refresh optimization and guide replacement to actual native remaining targets.
+    bool trace_update_pins = false; ///< Observe accepted preference changes against the exact native remaining-target list.
+    bool planar_feedback = false; ///< Also consider guided-path ordinary planar overuse after the normal cooldown.
+    bool feedback = false;            ///< Selective refresh of guides on VPR-selected reroute nets.
+    int cooldown = 3;                  ///< Minimum iterations between refresh attempts.
+    double refresh_margin = .05;       ///< Required relative surrogate improvement.
+    bool final_trace = false;          ///< Emit one final per-connection guide/path table.
+    bool post_legal_release = false;   ///< Release guide use after native first legal convergence.
+    bool post_legal_freeze = false;    ///< Independently freeze planning, retaining guide use.
+    bool edge_encoding = false;       ///< Prefer actual crossing-edge sources in imported single-layer-node graphs.
+};
+
+/** @brief Parse modes exactly; misspellings must not silently run the baseline. */
+const t_settings& settings() {
+    static const t_settings value = [] {
+        t_settings result;
+        const char* env = std::getenv("VPR_H3D_MODE");
+        std::string mode = env ? env : "off";
+        if (mode == "off")
+            result.mode = e_h3d_mode::OFF;
+        else if (mode == "candidates")
+            result.mode = e_h3d_mode::CANDIDATES;
+        else if (mode == "static")
+            result.mode = e_h3d_mode::STATIC;
+        else if (mode == "dynamic")
+            result.mode = e_h3d_mode::DYNAMIC;
+        else if (mode == "dynamic_whole")
+            result.mode = e_h3d_mode::DYNAMIC_WHOLE;
+        else if (mode == "dynamic_subtree")
+            result.mode = e_h3d_mode::DYNAMIC_SUBTREE;
+        else
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Unknown VPR_H3D_MODE '%s'", mode.c_str());
+        float candidates = read_number("VPR_H3D_CANDIDATES", 8.f);
+        if (candidates < 1.f || candidates > 64.f || std::floor(candidates) != candidates)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_CANDIDATES must be an integer in [1,64]");
+        result.candidates = static_cast<size_t>(candidates);
+        result.miss_weight = read_number("VPR_H3D_MISS_WEIGHT", 2.f);
+        const char* release = std::getenv("VPR_H3D_POST_LEGAL_RELEASE");
+        if (release && std::string(release) != "0" && std::string(release) != "1")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_POST_LEGAL_RELEASE must be 0 or 1");
+        result.post_legal_release = release && std::string(release) == "1";
+        const char* freeze = std::getenv("VPR_H3D_POST_LEGAL_FREEZE");
+        if (freeze && std::string(freeze) != "0" && std::string(freeze) != "1")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_POST_LEGAL_FREEZE must be 0 or 1");
+        result.post_legal_freeze = freeze && std::string(freeze) == "1";
+        if (result.post_legal_freeze && result.post_legal_release)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Post-legal freeze and release are independent experiments; do not combine");
+        const char* tie_pressure = std::getenv("VPR_H3D_DP_TIE_PRESSURE");
+        if (tie_pressure && std::string(tie_pressure) != "0" && std::string(tie_pressure) != "1")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_DP_TIE_PRESSURE must be 0 or 1");
+        result.dp_tie_pressure = tie_pressure && std::string(tie_pressure) == "1";
+        const char* margin_pressure = std::getenv("VPR_H3D_DP_MARGIN_PRESSURE");
+        if (margin_pressure && std::string(margin_pressure) != "0" && std::string(margin_pressure) != "1")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_DP_MARGIN_PRESSURE must be 0 or 1");
+        result.dp_margin_pressure = margin_pressure && std::string(margin_pressure) == "1";
+        result.opening_weight = read_number("VPR_H3D_OPENING_WEIGHT", 8.f);
+        const char* search = std::getenv("VPR_H3D_REACHABILITY");
+        std::string reachability = search ? search : "bfs";
+        if (reachability != "bfs" && reachability != "scc")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_REACHABILITY must be bfs or scc");
+        result.use_scc = reachability == "scc";
+        if ((result.dp_tie_pressure || result.dp_margin_pressure) && !result.use_scc)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "DP tie pressure requires the SCC finite-table planner");
+        const char* encoding_env = std::getenv("VPR_H3D_GRAPH_ENCODING");
+        std::string encoding = encoding_env ? encoding_env : "native";
+        if (encoding != "native" && encoding != "edge")
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "VPR_H3D_GRAPH_ENCODING must be native or edge");
+        result.edge_encoding = encoding == "edge";
+        if (result.edge_encoding && !result.use_scc)
+            VPR_FATAL_ERROR(VPR_ERROR_ROUTE, "Edge encoding requires SCC planning");
+        const char* score = std::getenv("VPR_H3D_CANDIDATE_COST");
+        std::string cost = score ? score : "geometry";
+        if (cost != "geometry" && cost != "delay")
