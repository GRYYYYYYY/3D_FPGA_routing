+};
diff --git a/vpr/src/route/h3d_delay_search.h b/vpr/src/route/h3d_delay_search.h
new file mode 100644
index 0000000..a7985c7
--- /dev/null
+++ b/vpr/src/route/h3d_delay_search.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <queue>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+/** Bounded Dijkstra: only settled terminal distances are returned. A budget
+ * exhaustion is an unknown result for absent terminals, never infeasibility.
+ * The caller supplies directed edges; terminal nodes are not expanded. */
+class H3dDelaySearch {
+  public:
+    struct WitnessStep {
+        size_t node, parent;
+        double edge_weight; ///< The exact directed adapter edge used to label node.
+    };
+    struct Result {
+        std::vector<std::pair<size_t, double>> terminals;
+        size_t settled = 0;
+        bool budget_exhausted = false;
+        std::vector<WitnessStep> witness; ///< Optional forest for settled nodes only.
+    };
+    explicit H3dDelaySearch(size_t nodes)
+        : distance_(nodes), generation_(nodes, 0), settled_(nodes, 0) {}
+
+    template<typename Terminal, typename Expand>
+    Result query(size_t source, size_t budget, Terminal terminal, Expand expand, bool capture_witness = false) {
+        if (++epoch_ == 0) {
+            std::fill(generation_.begin(), generation_.end(), 0);
+            std::fill(settled_.begin(), settled_.end(), 0);
+            epoch_ = 1;
+        }
+        using Item = std::pair<double, size_t>;
+        std::priority_queue<Item, std::vector<Item>, std::greater<Item>> queue;
+        distance_.at(source) = 0.;
+        generation_[source] = epoch_;
+        if (capture_witness) {
+            // Allocate lazily; the disabled path retains the original storage
+            // and relaxation decisions. Parent links always originate at an
+            // already settled node, including in graphs with zero-cost cycles.
+            parent_.resize(distance_.size());
+            parent_weight_.resize(distance_.size());
+            parent_[source] = source;
+            parent_weight_[source] = 0.;
+        }
+        queue.emplace(0., source);
+        Result result;
+        while (!queue.empty() && result.settled < budget) {
+            auto [cost, node] = queue.top();
+            queue.pop();
+            if (settled_[node] == epoch_ || cost != distance_[node]) continue;
+            settled_[node] = epoch_;
+            ++result.settled;
+            if (capture_witness) result.witness.push_back({node, parent_[node], parent_weight_[node]});
+            if (terminal(node)) {
+                result.terminals.emplace_back(node, cost);
+                continue;
+            }
+            expand(node, [&](size_t next, double weight) {
+                if (!std::isfinite(weight) || weight < 0.)
+                    throw std::invalid_argument("H3D Dijkstra requires finite nonnegative weights");
+                double candidate = cost + weight;
+                if (generation_.at(next) != epoch_ || candidate < distance_[next]) {
+                    generation_[next] = epoch_;
+                    distance_[next] = candidate;
+                    if (capture_witness) {
+                        parent_[next] = node;
+                        parent_weight_[next] = weight;
+                    }
+                    queue.emplace(candidate, next);
+                }
+            });
+        }
+        result.budget_exhausted = !queue.empty();
+        return result;
+    }
+
+  private:
+    std::vector<double> distance_;
+    std::vector<size_t> parent_;
+    std::vector<double> parent_weight_;
+    std::vector<uint32_t> generation_, settled_;
+    uint32_t epoch_ = 0;
+};
diff --git a/vpr/src/route/h3d_equivalent_guides.h b/vpr/src/route/h3d_equivalent_guides.h
new file mode 100644
index 0000000..ea606e3
--- /dev/null
+++ b/vpr/src/route/h3d_equivalent_guides.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+/** @brief Admit an exactly measured alternative that is no slower within a small dead band and no pricier.
+ * Delay inputs use graph-delay units; negotiated opening charges use the same
+ * dimensionless planner scale. This local criterion is not a global QoR proof.
+ */
+inline bool h3d_equivalent_guide(double chosen_delay, double alternative_delay, double chosen_charge, double alternative_charge) {
+    if (!std::isfinite(chosen_delay) || !std::isfinite(alternative_delay)
+        || !std::isfinite(chosen_charge) || !std::isfinite(alternative_charge)
+        || chosen_delay < 0. || alternative_delay < 0. || chosen_charge < 0. || alternative_charge < 0.) return false;
+    return alternative_delay <= chosen_delay + .02
+           && alternative_charge <= chosen_charge + 1.e-10 * std::max(1., chosen_charge);
+}
diff --git a/vpr/src/route/h3d_exit_price.h b/vpr/src/route/h3d_exit_price.h
new file mode 100644
index 0000000..d11896c
--- /dev/null
+++ b/vpr/src/route/h3d_exit_price.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+/** @brief Bounded dimensionless branch surcharge above an uncongested crossing destination.
+ * The caller supplies the minimum negotiated price over feasible exits. This
+ * is a relaxed congestion surrogate, not a joint delay/congestion path cost.
+ */
+inline double h3d_exit_price_premium(double price, double opening_weight, double weight) {
+    if (!std::isfinite(price) || !std::isfinite(opening_weight) || !std::isfinite(weight)
+        || opening_weight <= 0. || weight <= 0.) return 0.;
+    return opening_weight * std::min(1., weight) * std::clamp(price - 1., 0., 1.);
+}
